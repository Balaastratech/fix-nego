# ─── Desktop Companion — example environment (copy to desktop/.env) ───────────
# desktop/.env is gitignored. These values are read by main.js at startup (dev).
# Packaged builds use OS env vars; unset values fall back to the shipped defaults.
# After editing, restart the app (npm start).
# ─────────────────────────────────────────────────────────────────────────────

# ── Backend endpoint ─────────────────────────────────────────────────────────
# Shipped builds default to the hosted production backend:
#     wss://api.balaastratech.com/ws
# For LOCAL DEV, point this at your local backend so npm start uses localhost:
COMPANION_BACKEND_WS=ws://localhost:8000/ws
# HTTP base is auto-derived from the WS URL (ws->http, wss->https, drop /ws).
# Override only if your HTTP host differs from the WS host:
# COMPANION_BACKEND_HTTP=http://localhost:8000

# ── Shared token (Phase C) ───────────────────────────────────────────────────
# Must MATCH the hosted backend's COMPANION_SHARED_TOKEN. Leave EMPTY for local
# dev (the backend also leaves it empty → no auth). When set, it is appended to
# the WS URL (?token=) and sent on REST calls (X-Companion-Token).
# COMPANION_SHARED_TOKEN=

# ── Privacy mode (Hold-to-Ask mic muting) ────────────────────────────────────
#   hotkey   (recommended) Sends the meeting app's mute hotkey (Zoom Alt+A, etc).
#            One-time: Zoom -> Settings -> Keyboard Shortcuts -> tick
#            "Enable Global Shortcut" for Mute/Unmute My Audio.
#   auto / redirect-cable / vbcable  — see desktop/.env for full descriptions.
COMPANION_PRIVACY_MODE=hotkey

# Whether the legacy VB-Cable forward-and-mute path may be used (on|off|auto).
COMPANION_VBCABLE=off
