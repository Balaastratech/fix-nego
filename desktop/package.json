{
  "name": "ai-negotiation-copilot-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Windows desktop companion for the AI negotiation copilot",
  "author": "OpenAI Codex",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.balaastra.negotiationcompanion",
    "productName": "Negotiation Companion",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "scripts/audio-isolator.ps1",
        "to": "scripts/audio-isolator.ps1"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    }
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "application-loopback": "^1.2.6",
    "dotenv": "^16.6.1"
  }
}
