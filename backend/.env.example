# ─────────────────────────────────────────────────────────────────────────────
# Multi-provider AI (optional). These seed DEFAULTS only — the in-app Settings
# page (Dashboard → Settings tab) writes backend/data/runtime_providers.json and
# overrides everything below at runtime WITHOUT a restart. Leave blank to keep
# the Google-only default behavior. Live Voice is Google-only this release.
#   Text/Reasoning/Vision/Fast: google | openai | anthropic | groq | deepseek | openrouter
#   STT: google | deepgram | openai | groq | assemblyai
# OpenAI, Groq, DeepSeek and OpenRouter all use the OpenAI-compatible schema.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
ASSEMBLYAI_API_KEY=
ELEVENLABS_API_KEY=
# Master revert switch: set to false to ignore the in-app Settings entirely and
# use ONLY the .env values below (exact pre-multi-provider behavior).
PROVIDER_RUNTIME_OVERRIDE_ENABLED=true
# Google backend (Vertex vs AI Studio) is chosen by GOOGLE_GENAI_USE_VERTEXAI
# below, OR overridden per-machine from the Settings UI (Advanced → Google backend).
# AI Studio mode uses the pasted Google key (no GCP project/credentials) and the
# AI Studio Live model IDs below; Vertex mode is unchanged. Live model IDs differ
# per backend (verified from https://ai.google.dev/gemini-api/docs/models):
GEMINI_LIVE_MODEL_AISTUDIO=gemini-2.5-flash-native-audio-preview-12-2025
GEMINI_LIVE_FALLBACK_AISTUDIO=gemini-3.1-flash-live-preview
# Optional per-slot defaults (UI overrides these). Defaults shown are the
# current Google values used when unset.
# REASONING_PROVIDER=google
# REASONING_MODEL=gemini-2.5-pro
# FAST_TEXT_PROVIDER=google
# FAST_TEXT_MODEL=gemini-2.5-flash
# VISION_PROVIDER=google
# VISION_MODEL=gemini-2.5-flash
# STT_PROVIDER=
# STT_MODEL=
# ─────────────────────────────────────────────────────────────────────────────

# Vertex AI Configuration
GOOGLE_GENAI_USE_VERTEXAI=True
GOOGLE_CLOUD_PROJECT=ai-negotiation-copilot
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_STT_REGION=us
GOOGLE_STT_LOCATION=us
GOOGLE_STT_RECOGNIZER=_
GOOGLE_STT_MODEL=chirp_3
GOOGLE_STT_DIARIZATION_ENABLED=True
TRANSCRIPTION_PROVIDER=google_stt
DEEPGRAM_API_KEY=your_deepgram_api_key_here
DEEPGRAM_API_BASE_URL=https://api.deepgram.com/v1/listen
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE_CODES=en-US,hi-IN,es-US
DEEPGRAM_DIARIZATION_ENABLED=False
DEEPGRAM_UTTERANCE_SPLIT=0.45
STT_MAX_RETRIES=2
STT_BASE_BACKOFF_MS=300
# Using Application Default Credentials (no key file needed)
# GOOGLE_APPLICATION_CREDENTIALS is not needed when using ADC

# Model names (without google/ prefix - code adds it automatically)
GEMINI_MODEL=gemini-live-2.5-flash-native-audio
GEMINI_MODEL_FALLBACK=gemini-2.5-flash

# PerfectListener Configuration (disabled for SpeechBrain-first runtime)
PERFECT_LISTENER_ENABLED=False
PERFECT_LISTENER_FALLBACK=True
HF_TOKEN=your_huggingface_token_here

# Heavy ML Components (disable for 2-speaker scenarios to improve performance)
# ──────────────────────────────────────────────────────────────────────────────
# ENABLE_OVERLAP_DETECTION: Pyannote OverlappedSpeechDetection model
#   What it does: Detects when multiple speakers talk simultaneously (overlap)
#   Performance cost: ~30ms per 1s audio (CPU), ~10ms (GPU)
#   Model size: ~100MB
#   
#   When to DISABLE (false):
#     - 2-speaker conversations (user + counterparty only)
#     - CPU-only systems (no GPU available)
#     - Want faster processing and lower memory usage
#     - Overlap is rare or acceptable to miss
#   
#   When to ENABLE (true):
#     - 3+ speakers in conversation
#     - GPU server available
#     - Overlap detection is critical for your use case
#     - Multi-party negotiations or meetings
ENABLE_OVERLAP_DETECTION=false

# ENABLE_SPEECH_SEPARATION: Conv-TasNet speech separation model
#   What it does: Separates overlapping speech into individual clean streams
#   Performance cost: ~200ms per 1s audio (CPU), ~50ms (GPU)
#   Model size: ~5MB
#   Depends on: ENABLE_OVERLAP_DETECTION (no point separating if not detecting)
#   
#   When to DISABLE (false):
#     - 2-speaker conversations (user + counterparty only)
#     - CPU-only systems (no GPU available)
#     - Want faster processing
#     - Overlap is rare or you can tolerate mixed audio
#   
#   When to ENABLE (true):
#     - 3+ speakers with frequent overlap
#     - GPU server available
#     - Need clean separated audio for accurate transcription
#     - Multi-party negotiations where overlap must be resolved
ENABLE_SPEECH_SEPARATION=false

# Pyannote VAD Thresholds
PYANNOTE_MIN_DURATION_ON=0.25
PYANNOTE_MIN_DURATION_OFF=0.5

# WeSpeaker Configuration
WESPEAKER_ENABLED=False
WESPEAKER_THRESHOLD=0.70

# Speaker Recognition Configuration
SPEAKER_RECOGNITION_ENABLED=True
RESEMBLYZER_ENABLED=False
SPEECHBRAIN_ENABLED=True
SPEECHBRAIN_DEVICE=cpu
SPEECHBRAIN_MIN_BIND_SECONDS=1.5
SPEECHBRAIN_ACCEPT_THRESHOLD=0.55
SPEECHBRAIN_RECHECK_THRESHOLD=0.25
SPEECHBRAIN_AMBIGUOUS_LOW=0.10
SPEECHBRAIN_AMBIGUOUS_HIGH=0.53
SPEECHBRAIN_ENROLLMENT_TIMEOUT_SECONDS=90.0
SPEAKER_SIMILARITY_THRESHOLD=0.70
SPEAKER_VAD_AGGRESSIVENESS=1
SPEAKER_MIN_SEGMENT_DURATION=1.0
MIN_TRANSCRIBE_DURATION_MS=800
MIN_CONTEXT_DURATION_MS=800
SPEAKER_ENROLLMENT_OPTIONAL=True
AZURE_SPEAKER_VERIFICATION_ENABLED=false
AZURE_SPEAKER_SUBSCRIPTION_KEY=your_azure_speech_key_here
AZURE_SPEAKER_REGION=eastus
AZURE_SPEAKER_API_VERSION=2024-02-15-preview
AZURE_SPEAKER_MIN_VERIFICATION_SECONDS=3.0
AZURE_ENROLLMENT_MIN_EFFECTIVE_SPEECH_SECONDS=15.0
USER_CONTRADICTION_THRESHOLD=0.42
USER_REBIND_MARGIN=0.10
SPEAKER_RECHECK_WINDOW_SECONDS=45.0

# CORS Configuration
CORS_ORIGINS=http://localhost:3000

# Logging
LOG_LEVEL=INFO
CONVERSATION_AUDIT_LOG_ENABLED=True
CONVERSATION_AUDIT_LOG_PATH=data/logs/copilot_conversation_audit.jsonl
EVAL_MODE_ENABLED=False
EVAL_REPORT_DIR=data/eval_reports
AUDIO_EVAL_FIXTURE_DIR=evals/audio_fixtures
AUDIO_EVAL_REPORT_DIR=data/audio_eval_reports
EVAL_JUDGE_MODEL=gemini-2.5-flash

# Session Configuration
SESSION_TTL_SECONDS=3600

# ── Phase C — shared bearer token (hosted/public box) ─────────────────────────
# EMPTY (default) = auth disabled (localhost dev unchanged). On the Oracle VM set
# a long random value (and the SAME value in the desktop build) to gate /ws and
# the sensitive REST endpoints. See deploy/.env.oracle.example + deploy/DEPLOY.md.
COMPANION_SHARED_TOKEN=

# ── Clerk identity + app-session JWT (Phase auth) ──────────────────────────────
# Create a free Clerk app at https://dashboard.clerk.com
# Enable Email/Password + Google in Clerk dashboard. Require email verification.
# CLERK_PUBLISHABLE_KEY: from Clerk → API Keys (pk_live_... or pk_test_...)
# CLERK_JWKS_URL:  https://<frontend-api>.clerk.accounts.dev/.well-known/jwks.json
# CLERK_ISSUER:    https://<frontend-api>.clerk.accounts.dev  (no trailing slash)
# JWT_SECRET_KEY:  python -c "import secrets; print(secrets.token_urlsafe(48))"
CLERK_PUBLISHABLE_KEY=
CLERK_JWKS_URL=
CLERK_ISSUER=
CLERK_AUTHORIZED_PARTY=
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=30
# Flip to True after verifying the full Clerk→desktop flow end-to-end.
# When False (default), open dev behavior is unchanged (no login required).
AUTH_REQUIRED=False

# ── ASK_AI native audio path (reversible feature flag) ──────────────────
# Stream private question audio during hold directly to Gemini Live
ASK_AI_NATIVE_AUDIO=true
# Suppress final Gemini native transcriptions from publishing to the frontend
ASK_AI_SUPPRESS_NATIVE_TRANSCRIPTION=true
