# ─────────────────────────────────────────────────────────────────────────────
# Oracle VM backend/.env — LEAN HOSTED PROFILE (Phase B/C/D)
# Copy this to backend/.env ON THE VM ONLY. Do NOT copy your local Vertex .env.
#
#   cp deploy/.env.oracle.example backend/.env && chmod 600 backend/.env
#
# This profile matches requirements-desktop.txt (no torch / speechbrain /
# pyannote / whisper). It runs BYOK: each desktop user pastes their OWN keys, so
# the backend keys below stay EMPTY. The heavy speaker/diarization paths are all
# disabled so nothing tries to import a package the lean profile omits.
# ─────────────────────────────────────────────────────────────────────────────

# ── Clerk identity + app-session JWT (Phase auth) ─────────────────────────────
# Create at https://dashboard.clerk.com — enable Email/Password + Google.
CLERK_PUBLISHABLE_KEY=CHANGE_ME
CLERK_JWKS_URL=https://YOUR_FRONTEND_API.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER=https://YOUR_FRONTEND_API.clerk.accounts.dev
CLERK_AUTHORIZED_PARTY=
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=30
# Flip to True after verifying the full end-to-end flow.
AUTH_REQUIRED=True

# ── Phase C — shared bearer token (REQUIRED on a public box) ──────────────────
# Generate a strong random value and put the SAME value in the desktop build's
# COMPANION_SHARED_TOKEN (desktop/.env for dev, or OS env for a packaged build).
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
COMPANION_SHARED_TOKEN=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# ── Google backend: AI Studio / BYOK (NOT Vertex) ─────────────────────────────
# Key-only mode — no GCP project or service-account credentials on the VM.
# Users paste their own Google AI Studio key in the desktop Settings page.
GOOGLE_GENAI_USE_VERTEXAI=False
GOOGLE_CLOUD_PROJECT=
GEMINI_API_KEY=
GEMINI_LIVE_MODEL_AISTUDIO=gemini-2.5-flash-native-audio-preview-12-2025
GEMINI_LIVE_FALLBACK_AISTUDIO=gemini-3.1-flash-live-preview

# ── Multi-provider keys: leave EMPTY (BYOK — sent per-session from desktop) ────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
ASSEMBLYAI_API_KEY=
ELEVENLABS_API_KEY=
PROVIDER_RUNTIME_OVERRIDE_ENABLED=true
PER_SESSION_PROVIDER_OVERRIDE_ENABLED=true

# ── STT: Deepgram over HTTP/WebSocket (no SDK, no Google STT on lean profile) ──
TRANSCRIPTION_PROVIDER=deepgram
DEEPGRAM_API_KEY=
DEEPGRAM_API_BASE_URL=https://api.deepgram.com/v1/listen
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE_CODES=en-US,hi-IN,es-US
DEEPGRAM_DIARIZATION_ENABLED=False

# ── Heavy/ML paths DISABLED (their packages are NOT in requirements-desktop) ──
SPEAKER_RECOGNITION_ENABLED=False
SPEECHBRAIN_ENABLED=False
RESEMBLYZER_ENABLED=False
WESPEAKER_ENABLED=False
PERFECT_LISTENER_ENABLED=False
AZURE_SPEAKER_VERIFICATION_ENABLED=False
ENABLE_OVERLAP_DETECTION=false
ENABLE_SPEECH_SEPARATION=false

# ── CORS: desktop loads from file:// (origin "null", added in code). Keep a
# placeholder web origin; the desktop origins are whitelisted in main.py. ──────
CORS_ORIGINS=http://localhost:3000

# ── Logging / sessions ────────────────────────────────────────────────────────
LOG_LEVEL=INFO
SESSION_TTL_SECONDS=3600
ASK_AI_NATIVE_AUDIO=true
ASK_AI_SUPPRESS_NATIVE_TRANSCRIPTION=true
